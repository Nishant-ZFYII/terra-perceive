<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     viewBox="0 150 1200 130" width="1200" height="130"
     font-family="Helvetica, Arial, sans-serif">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="5"
            orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L10,5 L0,10 z" fill="#1F1F1F"/>
    </marker>
  </defs>

  <!-- Connectors -->
  <g stroke="#1F1F1F" stroke-width="1.5" fill="none">
    <line x1="230" y1="215" x2="280" y2="215" marker-end="url(#arrow)"/>
    <line x1="470" y1="215" x2="520" y2="215" marker-end="url(#arrow)"/>
    <line x1="710" y1="215" x2="770" y2="215" marker-end="url(#arrow)"/>
    <line x1="960" y1="215" x2="1025" y2="215" marker-end="url(#arrow)"/>
  </g>

  <!-- LiDAR scan -->
  <g>
    <rect x="40" y="170" width="190" height="90" fill="#28DBFF" stroke="#1F1F1F" stroke-width="1"/>
    <text x="135" y="207" text-anchor="middle" font-size="14" fill="#1F1F1F">LiDAR scan</text>
    <text x="135" y="227" text-anchor="middle" font-size="14" fill="#1F1F1F">(10 Hz, 64 beams)</text>
  </g>

  <!-- RANSAC ground removal -->
  <g>
    <rect x="280" y="170" width="190" height="90" fill="#28DBFF" stroke="#1F1F1F" stroke-width="1"/>
    <text x="375" y="207" text-anchor="middle" font-size="14" fill="#1F1F1F">RANSAC</text>
    <text x="375" y="227" text-anchor="middle" font-size="14" fill="#1F1F1F">ground removal</text>
  </g>

  <!-- DBSCAN -->
  <g>
    <rect x="520" y="170" width="190" height="90" fill="#28DBFF" stroke="#1F1F1F" stroke-width="1"/>
    <text x="615" y="207" text-anchor="middle" font-size="14" fill="#1F1F1F">DBSCAN</text>
    <text x="615" y="227" text-anchor="middle" font-size="14" fill="#1F1F1F">(eps = 0.5, min_samples = 10)</text>
  </g>

  <!-- SORT tracker -->
  <g>
    <rect x="770" y="170" width="190" height="90" fill="#28DBFF" stroke="#1F1F1F" stroke-width="1"/>
    <text x="865" y="207" text-anchor="middle" font-size="14" fill="#1F1F1F">SORT tracker</text>
    <text x="865" y="227" text-anchor="middle" font-size="14" fill="#1F1F1F">Kalman + Hungarian</text>
  </g>

  <!-- Italic output label, no border -->
  <text x="1085" y="220" text-anchor="middle" font-size="18" font-style="italic" fill="#1F1F1F">tracked objects with stable ID&#39;s</text>
</svg>
