# Dockerfile.perception — C++ perception services
# Builds RANSAC, traversability, projection, tracker, safety from source
FROM ros:humble-ros-base

RUN apt-get update && apt-get install -y \
    libeigen3-dev \
    ros-humble-nav2-costmap-2d \
    ros-humble-tf2-ros \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws/src/construction_perception
COPY CMakeLists.txt package.xml ./
COPY include/ include/
COPY src/ src/
COPY ros2_nodes/ ros2_nodes/
COPY config/ config/
COPY launch/ launch/

WORKDIR /ws
RUN . /opt/ros/humble/setup.sh && colcon build --symlink-install

ENTRYPOINT ["/bin/bash", "-c", ". /ws/install/setup.bash && exec \"$@\"", "--"]
