<launch>
    <include file="$(find platform_description)/launch/description.launch"/>
    <param name="/use_sim_time" value="true" />

    <node name="cartographer_offline_node" pkg="cartographer_ros"
          type="cartographer_offline_node" args="
          -configuration_directory $(arg config_path)
          -configuration_basenames warthog_3d_ouster.lua
          -urdf_filenames $(find platform_description)/urdf/warthog.urdf
          -bag_filenames $(arg bag_filename)" output="screen">
        <remap from="points2" to="/os1_cloud_node/points" />
        <remap from="imu" to="/vectornav/IMU"/>
    </node>

    <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
          type="cartographer_occupancy_grid_node" args="-resolution 0.05" />
</launch>
